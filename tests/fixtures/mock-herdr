#!/bin/sh
# mock-herdr — POSIX sh fixture for herdr-mouse bats tests
# Controlled via env:
#   MOCK_HERDR_FAIL=1          -> exit 1 (herdr unreachable)
#   MOCK_FOCUS_CHANGED=false   -> pane focus returns changed:false
#   MOCK_TAB_MODE=single       -> tab list returns single tab
#   MOCK_WS_MODE=single        -> workspace list returns single workspace
#   MOCK_LOG=/tmp/file         -> append call args to log file
set -eu

LOG_FILE="${MOCK_LOG:-/tmp/mock-herdr.log}"
# best-effort log, never fail the mock
printf '%s\n' "$*" >> "$LOG_FILE" 2>/dev/null || true

if [ "${MOCK_HERDR_FAIL:-}" = "1" ]; then
  echo "herdr unreachable" >&2
  exit 1
fi

# default modes
FOCUS_CHANGED="${MOCK_FOCUS_CHANGED:-true}"
TAB_MODE="${MOCK_TAB_MODE:-multi}"
WS_MODE="${MOCK_WS_MODE:-multi}"

case "${1:-}" in
  pane)
    case "${2:-}" in
      focus)
        if [ "$FOCUS_CHANGED" = "false" ]; then
          printf '{"result":{"focus":{"changed":false,"reason":"no_neighbor"}}}\n'
        else
          printf '{"result":{"focus":{"changed":true,"focused_pane_id":"pane-2"}}}\n'
        fi
        ;;
      zoom)
        printf '{"result":{"layout":{"zoomed":true}}}\n'
        ;;
      *)
        printf '{"result":{}}\n'
        ;;
    esac
    ;;
  workspace)
    case "${2:-}" in
      list)
        if [ "$WS_MODE" = "single" ]; then
          printf '{"result":{"workspaces":[{"workspace_id":"ws-1","focused":true}]}}\n'
        else
          printf '{"result":{"workspaces":[{"workspace_id":"ws-1","focused":true},{"workspace_id":"ws-2","focused":false}]}}\n'
        fi
        ;;
      focus)
        printf '{"result":{}}\n'
        ;;
      *)
        printf '{"result":{}}\n'
        ;;
    esac
    ;;
  tab)
    case "${2:-}" in
      list)
        if [ "$TAB_MODE" = "single" ]; then
          printf '{"result":{"tabs":[{"tab_id":"tab-1","number":1,"focused":true}]}}\n'
        else
          printf '{"result":{"tabs":[{"tab_id":"tab-1","number":1,"focused":true},{"tab_id":"tab-2","number":2,"focused":false}]}}\n'
        fi
        ;;
      focus)
        printf '{"result":{}}\n'
        ;;
      *)
        printf '{"result":{}}\n'
        ;;
    esac
    ;;
  *)
    echo "unknown mock herdr command: $*" >&2
    exit 1
    ;;
esac
exit 0
